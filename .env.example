# PostgreSQL Database (Dedicated database for Chatbot data: users, documents, chunks, conversations, messages)
DATABASE_URL=postgresql://smk_user:smk_password_123@localhost:5432/chatbot_db

# Live Hosted Qdrant Vector Database URL (Pure vector storage only)
QDRANT_URL=https://your-live-qdrant-url.cloud.qdrant.io:6333
# Optional API Key (required for Qdrant Cloud or secured live clusters)
QDRANT_API_KEY=your_live_qdrant_api_key
QDRANT_COLLECTION=store_knowledge_base

# Google Gemini LLM & Embeddings Settings
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# JWT Authentication & Shared Secret (matches e-commerce)
JWT_SECRET=super_secret_key_123
INTERNAL_SERVICE_KEY=internal_rag_secret_key_123

# Service URL & Port
NEXT_PUBLIC_APP_URL=http://localhost:8005
PORT=8005

